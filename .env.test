# Use this default local environment file with compose.dev.yml

# To enable / disable self-hosting features.
SELF_HOSTED=false

# Enable Synth market data (careful, this will use your API credits)
SYNTH_API_KEY=yourapikeyhere

POSTGRES_USER=finachy_user
POSTGRES_PASSWORD=finachy_password
# These values are used to avoid conflicts with other local dev setups
DB_PORT=4321
REDIS_URL=redis://localhost:6321/1

# Set to true if you want SimpleCov reports generated
COVERAGE=false

# Set to true to run test suite serially
DISABLE_PARALLELIZATION=false
